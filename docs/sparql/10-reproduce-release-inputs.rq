# Inspect the release transformation's software agent, version and source-file hashes so a judge can trace the published projection.
PREFIX ra: <https://w3id.org/rare-disease-atlas/vocab#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?agent ?releaseVersion ?source ?sourceUrl ?version ?hash ?licence WHERE {
  <https://w3id.org/rare-disease-atlas/activity/release%3Aprojection>
      prov:wasAssociatedWith ?agent ; dcterms:hasVersion ?releaseVersion ; prov:used ?source .
  ?source a prov:Entity ; dcterms:source ?sourceUrl ; dcterms:hasVersion ?version ;
          ra:sha256 ?hash ; dcterms:license ?licence .
} ORDER BY ?source ?agent ?releaseVersion ?sourceUrl ?version ?hash ?licence

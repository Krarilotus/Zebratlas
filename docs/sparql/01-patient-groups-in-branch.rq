# Find patient groups serving conditions in the epilepsy branch, including subclass descendants; no rows means this release cannot answer the job.
PREFIX ra: <https://w3id.org/rare-disease-atlas/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?condition ?group ?officialPage WHERE {
  ?condition rdfs:subClassOf* <https://w3id.org/rare-disease-atlas/id/MONDO%3A0005027> .
  ?group ra:serves_condition ?condition ; dcterms:source ?officialPage .
} ORDER BY ?condition ?group ?officialPage LIMIT 100

    rdfs:label "studied_for" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas studied_for connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:studies_condition a owl:ObjectProperty ;
    rdfs:label "studies_condition" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas studies_condition connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:subclass_of a owl:ObjectProperty ;
    rdfs:label "subclass_of" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas subclass_of connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation. Source hierarchy metadata; native release uses rdfs:subClassOf only after class interpretation verification." ;
    ra:semanticScope "source-qualified-connection" .

ra:submissionId a owl:DatatypeProperty ;
    rdfs:label "submissionId" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:submissionVersion a owl:DatatypeProperty ;
    rdfs:label "submissionVersion" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:targets a owl:ObjectProperty ;
    rdfs:label "targets" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas targets connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:termsPage a owl:ObjectProperty ;
    rdfs:label "termsPage" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Source terms evidence URL." ;
    ra:semanticScope "application" .

ra:underlyingEvidenceGroup a owl:DatatypeProperty ;
    rdfs:label "underlyingEvidenceGroup" ;
    rdfs:domain ra:QualifiedDiseasePhenotypeAssertion ;
    rdfs:range xsd:string ;
    skos:definition "HOOM extraction state/evidence grouping metadata; duplicate axioms are not independent support." ;
    ra:semanticScope "application" .

ra:upstreamFieldsJSON a owl:DatatypeProperty ;
    rdfs:label "upstreamFieldsJSON" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:viaPathway a owl:ObjectProperty ;
    rdfs:label "viaPathway" ;
    rdfs:domain ra:SemanticUnit ;
    rdfs:range ra:Entity ;
    skos:definition "Semantic unit membership/subject metadata; does not assert biomedical relations." ;
    ra:semanticScope "application" .

ra:BiologicalGene a owl:Class ;
    rdfs:label "Biological Gene" ;
    rdfs:subClassOf ra:MaterialEntity ;
    owl:disjointWith ra:ProteinMolecule ;
    skos:definition "A concrete genomic sequence-bearing material entity; never an HGNC database page or gene class." .

ra:DiseaseConcept a owl:Class ;
    rdfs:label "Disease Concept" ;
    rdfs:subClassOf ra:Concept ;
    skos:definition "A reified disease concept used for indexing; MONDO class IRIs remain classes in their original ontologies." .

ra:DiseaseProcess a owl:Class ;
    rdfs:label "Disease Process" ;
    rdfs:subClassOf ra:Process ;
    skos:definition "An actual pathological process in a bearer, not a MONDO disease class, disposition, diagnostic label, or record." .

ra:GeneConcept a owl:Class ;
    rdfs:label "Gene Concept" ;
    rdfs:subClassOf ra:Concept ;
    skos:definition "A reified concept of a gene type; not a gene molecule." .

ra:HumanPerson a owl:Class ;
    rdfs:label "Human Person" ;
    rdfs:subClassOf ra:MaterialEntity ;
    skos:definition "A living human material person, not an author identity record." .

ra:NavigationLead a owl:Class ;
    rdfs:label "Navigation Lead" ;
    rdfs:subClassOf ra:Assertion ;
    skos:definition "A hypothesis or retrieval lead for navigation, not evidence that a clinical or molecular relationship holds." .

ra:PaperContent a owl:Class ;
    rdfs:label "Paper Content" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "Content of a scholarly article, distinct from its bibliographic record and physical copy." .

ra:PhenotypeConcept a owl:Class ;
    rdfs:label "Phenotype Concept" ;
    rdfs:subClassOf ra:Concept ;
    skos:definition "A reified phenotype concept, distinct from a quality instance." .

ra:ProteinMolecule a owl:Class ;
    rdfs:label "Protein Molecule" ;
    rdfs:subClassOf ra:MaterialEntity ;
    skos:definition "A concrete protein molecular entity, distinct from its coding gene and database entry." .

ra:Quality a owl:Class ;
    rdfs:label "Quality" ;
    rdfs:subClassOf ra:Entity ;
    owl:disjointWith ra:Process ;
    skos:definition "An actual specifically borne characteristic, distinct from a phenotype class or annotation." .

ra:StudyExecution a owl:Class ;
    rdfs:label "Study Execution" ;
    rdfs:subClassOf ra:Process ;
    skos:definition "An actual execution of research, distinct from registration, protocol and planned study." .

ra:hasRecord a owl:ObjectProperty ;
    rdfs:label "hasRecord" ;
    rdfs:domain ra:SourceArtifact ;
    rdfs:range ra:SourceRecord ;
    skos:definition "Inverse of recordOf." ;
    ra:semanticScope "application" .

ra:recordOf a owl:ObjectProperty ;
    rdfs:label "recordOf" ;
    rdfs:domain ra:SourceRecord ;
    rdfs:range ra:SourceArtifact ;
    owl:inverseOf ra:hasRecord ;
    skos:definition "Source record belongs to an identified source artifact encoding/content." ;
    ra:semanticScope "application" .

ra:BiomedicalAssertion a owl:Class ;
    rdfs:label "Biomedical Assertion" ;
    rdfs:subClassOf ra:Assertion ;
    owl:disjointWith ra:NavigationLead ;
    skos:definition "A source-qualified proposition about biomedical entities or types; may be disputed or refuted." .

ra:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "An identifier information item. An identifier denotes a referent and never becomes it through lexical equality." .

ra:SocialEntity a owl:Class ;
    rdfs:label "Social Entity" ;
    rdfs:subClassOf ra:Entity ;
    skos:definition "A social organization or agreement viewed institutionally; BFO material collectives require an explicit separate facet." .

ra:SourceRecord a owl:Class ;
    rdfs:label "Source Record" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "Information content of an addressable record in a source artifact." .

ra:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:subClassOf ra:Entity ;
    skos:definition "A context dependent realizable role of a bearer; not the bearer or a role vocabulary term." .

ra:SourceArtifact a owl:Class ;
    rdfs:label "Source Artifact" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "Information content of a versioned upstream file or dataset; checksum describes a concrete encoding." .

ra:isAbout a owl:ObjectProperty ;
    rdfs:label "isAbout" ;
    rdfs:domain ra:InformationEntity ;
    rdfs:range ra:Entity ;
    skos:definition "Information content is about an explicitly identified entity or reified concept; no existential referent is fabricated." ;
    ra:semanticScope "application" .

ra:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:subClassOf ra:Entity ;
    skos:definition "A reified conceptual description; not the class extension or an instance of that class." .

ra:GeneDiseaseValidityAssertion a owl:Class ;
    rdfs:label "Gene Disease Validity Assertion" ;
    rdfs:subClassOf ra:BiomedicalAssertion ;
    skos:definition "A GenCC submitter-scoped gene disease inheritance validity classification; refutation remains explicit." .

ra:Assertion a owl:Class ;
    rdfs:label "Assertion" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "Information expressing a proposition and its evidential status; typing an assertion never asserts its proposition." .

ra:SemanticUnit a owl:Class ;
    rdfs:label "Semantic Unit" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "A versioned grouping or statement information unit with provenance." .

ra:MaterialEntity a owl:Class ;
    rdfs:label "Material Entity" ;
    rdfs:subClassOf ra:Entity ;
    owl:disjointWith ra:Process ;
    skos:definition "A concrete material bearer. Gene/protein records and organism model catalog entries are not automatically instances." .

ra:Process a owl:Class ;
    rdfs:label "Process" ;
    rdfs:subClassOf ra:Entity ;
    skos:definition "An actual occurrence unfolding in time, distinct from a protocol, process type, or database record." .

ra:QualifiedDiseasePhenotypeAssertion a owl:Class ;
    rdfs:label "Qualified Disease Phenotype Assertion" ;
    rdfs:subClassOf ra:BiomedicalAssertion ;
    skos:definition "An extracted HOOM source association, preserving disease/phenotype/frequency/diagnostic-role class references; not a diagnosis." .

ra:nodeKind a owl:DatatypeProperty ;
    rdfs:label "nodeKind" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Atlas projection indexing kind; not a biological class assertion. Broad domain deliberately avoids turning external class references into projection records." ;
    ra:semanticScope "application" .

ra:InformationEntity a owl:Class ;
    rdfs:label "Information Entity" ;
    rdfs:subClassOf prov:Entity,
        ra:Entity ;
    owl:disjointWith ra:MaterialEntity,
        ra:Process ;
    skos:definition "Repeatable information content, distinct from its physical storage, biological referent, and identifier string." .

ra:Node a owl:Class ;
    rdfs:label "Node" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "A local Atlas release projection entry; its nodeKind is an indexing category of represented content, not its biomedical ontological type." .

ra:Entity a owl:Class ;
    rdfs:label "Entity" ;
    skos:definition "An entity in the Atlas application universe; no automatic equation to a foundation top class." .


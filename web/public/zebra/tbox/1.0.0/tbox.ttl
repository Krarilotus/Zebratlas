@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ra: <https://w3id.org/rare-disease-atlas/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/rare-disease-atlas/ontology/tbox> a owl:Ontology ;
    dcterms:license <https://opensource.org/license/mit> ;
    rdfs:comment "Atlas authored application profile, under the repository MIT option. External imports retain their own terms. Resolve imports only through manifest-pinned local artifacts." ;
    owl:versionIRI <https://w3id.org/rare-disease-atlas/ontology/1.0.0/tbox> ;
    owl:versionInfo "1.0.0" .

ra:AddressableSourceRecord a owl:Class ;
    rdfs:label "Addressable Source Record" ;
    rdfs:subClassOf ra:InformationEntity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:InformationEntity [ a owl:Restriction ;
                        owl:onProperty ra:recordOf ;
                        owl:someValuesFrom ra:SourceArtifact ] ) ] ;
    skos:definition "Information entity with at least one explicit recordOf link to SourceArtifact." .

ra:AlignmentActivity a owl:Class ;
    rdfs:label "Alignment Activity" ;
    rdfs:subClassOf prov:Activity,
        ra:Process ;
    skos:definition "An actual mapping assessment execution; its products need not establish identity." .

ra:AssetRecord a owl:Class ;
    rdfs:label "Asset Record" ;
    rdfs:subClassOf ra:Node ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "asset" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as asset; no equation to the represented real entity." .

ra:BiologicalSample a owl:Class ;
    rdfs:label "Biological Sample" ;
    rdfs:subClassOf ra:MaterialEntity ;
    skos:definition "An actual biological specimen; catalog entries are information entities." .

ra:ChemicalSubstance a owl:Class ;
    rdfs:label "Chemical Substance" ;
    rdfs:subClassOf ra:MaterialEntity ;
    skos:definition "A concrete chemical material; drug designation and chemical class records are separate." .

ra:CommunityUnit a owl:Class ;
    rdfs:label "Community Unit" ;
    rdfs:subClassOf ra:SemanticUnit ;
    skos:definition "Information grouping contacts and resources; not a material or social community." .

ra:DiseaseDescription a owl:Class ;
    rdfs:label "Disease Description" ;
    rdfs:subClassOf ra:InformationEntity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:InformationEntity [ a owl:Restriction ;
                        owl:onProperty ra:isAbout ;
                        owl:someValuesFrom ra:DiseaseConcept ] ) ] ;
    skos:definition "Information entity with at least one explicit isAbout link to DiseaseConcept." .

ra:DiseaseRecord a owl:Class ;
    rdfs:label "Disease Record" ;
    rdfs:subClassOf ra:Node ;
    owl:disjointWith ra:DiseaseProcess ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "disease" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as disease; no equation to the represented real entity." .

ra:Edge a owl:Class ;
    rdfs:label "Edge" ;
    rdfs:subClassOf ra:Assertion ;
    skos:definition "An Atlas evidence-bearing edge/reifier including observed, extracted, inferred, hypothesis and withheld projections." .

ra:GeneDescription a owl:Class ;
    rdfs:label "Gene Description" ;
    rdfs:subClassOf ra:InformationEntity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:InformationEntity [ a owl:Restriction ;
                        owl:onProperty ra:isAbout ;
                        owl:someValuesFrom ra:GeneConcept ] ) ] ;
    skos:definition "Information entity with at least one explicit isAbout link to GeneConcept." .

ra:GeneRecord a owl:Class ;
    rdfs:label "Gene Record" ;
    rdfs:subClassOf ra:Node ;
    owl:disjointWith ra:BiologicalGene ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "gene" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as gene; no equation to the represented real entity." .

ra:GrantAgreement a owl:Class ;
    rdfs:label "Grant Agreement" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "Grant award agreement content, distinct from a payment or research activity." .

ra:GrantRecord a owl:Class ;
    rdfs:label "Grant Record" ;
    rdfs:subClassOf ra:Node ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "grant" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as grant; no equation to the represented real entity." .

ra:InferenceActivity a owl:Class ;
    rdfs:label "Inference Activity" ;
    rdfs:subClassOf prov:Activity,
        ra:Process ;
    skos:definition "An actual rule execution with explicit premise and rule witnesses." .

ra:IngestionActivity a owl:Class ;
    rdfs:label "Ingestion Activity" ;
    rdfs:subClassOf prov:Activity,
        ra:Process ;
    skos:definition "An actual data ingestion/reconstruction execution with source dependencies." .

ra:ItemUnit a owl:Class ;
    rdfs:label "Item Unit" ;
    rdfs:subClassOf ra:SemanticUnit ;
    skos:definition "Semantic unit collecting evidence about one indexed subject." .

ra:Link a owl:Class ;
    rdfs:label "Link" ;
    rdfs:subClassOf ra:Assertion ;
    skos:definition "Legacy server export connection record; semantic endpoints must be verified separately." .

ra:Mapping a owl:Class ;
    rdfs:label "Mapping" ;
    rdfs:subClassOf ra:Assertion ;
    skos:definition "An identifier or terminology correspondence claim with mapping evidence, not automatic individual identity." .

ra:MechanismItemGroupUnit a owl:Class ;
    rdfs:label "Mechanism Item Group Unit" ;
    rdfs:subClassOf ra:SemanticUnit ;
    skos:definition "A group of mechanism-related information; not proof of a shared mechanism." .

ra:ModelDescription a owl:Class ;
    rdfs:label "Model Description" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "A description of a strain, line, genotype or model; not its material realization." .

ra:OrganisationRecord a owl:Class ;
    rdfs:label "Organisation Record" ;
    rdfs:subClassOf ra:Node ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "organisation" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as organisation; no equation to the represented real entity." .

ra:OrganismModel a owl:Class ;
    rdfs:label "Organism Model" ;
    rdfs:subClassOf ra:MaterialEntity ;
    skos:definition "An actual organism used as a research model, distinct from a strain designation or catalog record." .

ra:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf ra:SocialEntity ;
    skos:definition "An institutional social agent; not automatically equal to the aggregate of all its current members." .

ra:OrganizationCollective a owl:Class ;
    rdfs:label "Organization Collective" ;
    rdfs:subClassOf ra:MaterialEntity ;
    skos:definition "The material aggregate of participants constituting an organization in a given context; separate from its institutional identity." .

ra:PaperRecord a owl:Class ;
    rdfs:label "Paper Record" ;
    rdfs:subClassOf ra:Node ;
    owl:disjointWith ra:PaperContent ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "paper" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as paper; no equation to the represented real entity." .

ra:PathwayConcept a owl:Class ;
    rdfs:label "Pathway Concept" ;
    rdfs:subClassOf ra:Concept ;
    skos:definition "A reified description of a pathway process type; not a pathway execution." .

ra:PathwayRecord a owl:Class ;
    rdfs:label "Pathway Record" ;
    rdfs:subClassOf ra:Node ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "pathway" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as pathway; no equation to the represented real entity." .

ra:PersonRecord a owl:Class ;
    rdfs:label "Person Record" ;
    rdfs:subClassOf ra:Node ;
    owl:disjointWith ra:HumanPerson ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "person" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as person; no equation to the represented real entity." .

ra:PhenotypeDescription a owl:Class ;
    rdfs:label "Phenotype Description" ;
    rdfs:subClassOf ra:InformationEntity ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:InformationEntity [ a owl:Restriction ;
                        owl:onProperty ra:isAbout ;
                        owl:someValuesFrom ra:PhenotypeConcept ] ) ] ;
    skos:definition "Information entity with at least one explicit isAbout link to PhenotypeConcept." .

ra:PhenotypeRecord a owl:Class ;
    rdfs:label "Phenotype Record" ;
    rdfs:subClassOf ra:Node ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "phenotype" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as phenotype; no equation to the represented real entity." .

ra:PhenotypicQuality a owl:Class ;
    rdfs:label "Phenotypic Quality" ;
    rdfs:subClassOf ra:Quality ;
    skos:definition "An actual phenotype quality in a bearer, not an HPO class or source frequency annotation." .

ra:ResearchRole a owl:Class ;
    rdfs:label "Research Role" ;
    rdfs:subClassOf ra:Role ;
    skos:definition "A context dependent role borne and realized by a research participant or resource." .

ra:StatementUnit a owl:Class ;
    rdfs:label "Statement Unit" ;
    rdfs:subClassOf ra:Assertion,
        ra:SemanticUnit ;
    skos:definition "Semantic unit expressing a proposition; hypothesis status does not assert that proposition." .

ra:StudyProtocol a owl:Class ;
    rdfs:label "Study Protocol" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "Research study plan or protocol information, distinct from its execution." .

ra:StudyRecord a owl:Class ;
    rdfs:label "Study Record" ;
    rdfs:subClassOf ra:Node ;
    owl:disjointWith ra:StudyExecution ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ra:Node [ a owl:Restriction ;
                        owl:hasValue "study" ;
                        owl:onProperty ra:nodeKind ] ) ] ;
    skos:definition "An Atlas projection record indexed as study; no equation to the represented real entity." .

ra:UnitLink a owl:Class ;
    rdfs:label "Unit Link" ;
    rdfs:subClassOf ra:InformationEntity ;
    skos:definition "Information linking semantic units." .

ra:about_condition a owl:ObjectProperty ;
    rdfs:label "about_condition" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas about_condition connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:about_gene a owl:ObjectProperty ;
    rdfs:label "about_gene" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas about_gene connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:assertionStatus a owl:DatatypeProperty ;
    rdfs:label "assertionStatus" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:author_of a owl:ObjectProperty ;
    rdfs:label "author_of" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas author_of connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:awarded_to a owl:ObjectProperty ;
    rdfs:label "awarded_to" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas awarded_to connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:bytes a owl:DatatypeProperty ;
    rdfs:label "bytes" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:integer ;
    skos:definition "Artifact encoding size in bytes." ;
    ra:semanticScope "application" .

ra:candidate_same_as a owl:ObjectProperty ;
    rdfs:label "candidate_same_as" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas candidate_same_as connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation. Navigation/mapping-only: does not entail clinical association, treatment or entity identity." ;
    ra:semanticScope "navigation-only" .

ra:claims_about a owl:ObjectProperty ;
    rdfs:label "claims_about" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas claims_about connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:classification a owl:ObjectProperty ;
    rdfs:label "classification" ;
    rdfs:domain ra:GeneDiseaseValidityAssertion ;
    rdfs:range ra:Entity ;
    skos:definition "Upstream GenCC controlled reference; assertion scoped by submitter/version/status, not promoted to universal clinical fact." ;
    ra:semanticScope "application" .

ra:classificationLabel a owl:DatatypeProperty ;
    rdfs:label "classificationLabel" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:codeSha256 a owl:DatatypeProperty ;
    rdfs:label "codeSha256" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:commit a owl:DatatypeProperty ;
    rdfs:label "commit" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:constitutedBy a owl:ObjectProperty ;
    rdfs:label "constitutedBy" ;
    rdfs:domain ra:SocialEntity ;
    rdfs:range ra:MaterialEntity ;
    skos:definition "Explicit institutional-to-material constitution link; never owl:sameAs." ;
    ra:semanticScope "application" .

ra:contactRoute a owl:DatatypeProperty ;
    rdfs:label "contactRoute" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:copyFields a owl:DatatypeProperty ;
    rdfs:label "copyFields" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:boolean ;
    skos:definition "Release source policy grants copying record fields." ;
    ra:semanticScope "application" .

ra:count a owl:DatatypeProperty ;
    rdfs:label "count" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:countsSha256 a owl:DatatypeProperty ;
    rdfs:label "countsSha256" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:denotes a owl:ObjectProperty ;
    rdfs:label "denotes" ;
    rdfs:domain ra:Identifier ;
    rdfs:range ra:Entity ;
    skos:definition "An identifier information item denotes an explicitly modelled referent; not an identity relation." ;
    ra:semanticScope "application" .

ra:disease a owl:ObjectProperty ;
    rdfs:label "disease" ;
    rdfs:domain ra:GeneDiseaseValidityAssertion ;
    rdfs:range ra:Entity ;
    skos:definition "Upstream GenCC controlled reference; assertion scoped by submitter/version/status, not promoted to universal clinical fact." ;
    ra:semanticScope "application" .

ra:edgeKind a owl:DatatypeProperty ;
    rdfs:label "edgeKind" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:eligibleForPositiveInference a owl:DatatypeProperty ;
    rdfs:label "eligibleForPositiveInference" ;
    rdfs:domain ra:QualifiedDiseasePhenotypeAssertion ;
    rdfs:range xsd:boolean ;
    skos:definition "Operational source assertion guard; false prevents positive clinical inference." ;
    ra:semanticScope "application" .

ra:evidenceCode a owl:DatatypeProperty ;
    rdfs:label "evidenceCode" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:evidenceLocator a owl:DatatypeProperty ;
    rdfs:label "evidenceLocator" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:evidenceSha256 a owl:DatatypeProperty ;
    rdfs:label "evidenceSha256" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:exclusionDiagnosticRole a owl:DatatypeProperty ;
    rdfs:label "exclusionDiagnosticRole" ;
    rdfs:domain ra:QualifiedDiseasePhenotypeAssertion ;
    rdfs:range xsd:boolean ;
    skos:definition "Operational source assertion guard; false prevents positive clinical inference." ;
    ra:semanticScope "application" .

ra:expectedObjectKinds a owl:AnnotationProperty .

ra:expectedSubjectKinds a owl:AnnotationProperty .


    ra:semanticScope "application" .

ra:gene_associated_with_condition a owl:ObjectProperty ;
    rdfs:label "gene_associated_with_condition" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas gene_associated_with_condition connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:hasAssociatedSemanticUnit a owl:ObjectProperty ;
    rdfs:label "hasAssociatedSemanticUnit" ;
    rdfs:domain ra:SemanticUnit ;
    rdfs:range ra:Entity ;
    skos:definition "Semantic unit membership/subject metadata; does not assert biomedical relations." ;
    ra:semanticScope "application" .

ra:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "hasIdentifier" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Identifier ;
    skos:definition "An entity has an identifier information item; not inverse functional." ;
    ra:semanticScope "application" .

ra:hasMember a owl:ObjectProperty ;
    rdfs:label "hasMember" ;
    rdfs:domain ra:SemanticUnit ;
    rdfs:range ra:Entity ;
    skos:definition "Semantic unit membership/subject metadata; does not assert biomedical relations." ;
    ra:semanticScope "application" .

ra:hasRole a owl:ObjectProperty ;
    rdfs:label "hasRole" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Role ;
    skos:definition "A bearer has a context dependent role; differs from class membership." ;
    ra:semanticScope "application" .

ra:hasSemanticUnitSubject a owl:ObjectProperty ;

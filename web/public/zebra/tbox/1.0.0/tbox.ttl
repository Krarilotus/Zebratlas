    rdfs:label "funds" ;
    rdfs:domain ra:Entity ;
    rdfs:range ra:Entity ;
    skos:definition "Atlas funds connection as qualified by its edge/source records. Neither transitive nor an OWL identity relation." ;
    ra:semanticScope "source-qualified-connection" .

ra:gateManifestSha256 a owl:DatatypeProperty ;
    rdfs:label "gateManifestSha256" ;
    rdfs:domain ra:Entity ;
    rdfs:range xsd:string ;
    skos:definition "Preserved Atlas metadata. Source lexical values are not automatically verified history." ;
    ra:semanticScope "application" .

ra:gene a owl:ObjectProperty ;
    rdfs:label "gene" ;
    rdfs:domain ra:GeneDiseaseValidityAssertion ;
    rdfs:range ra:Entity ;

# syntax=docker/dockerfile:1
FROM node:24.21.0-trixie-slim AS dependencies
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

FROM dependencies AS builder
COPY web ./
ARG NEXT_PUBLIC_API_URL=http://server:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_TELEMETRY_DISABLED=1
# Enable standalone inside the image, without changing the web agent's config.
RUN node -e 'const fs=require("node:fs"); const p="next.config.ts"; const c=fs.readFileSync(p,"utf8"); if(!c.includes("export default nextConfig;")) throw Error("Update Dockerfile.web for the new Next config export"); fs.writeFileSync(p,c.replace("export default nextConfig;","nextConfig.output = \"standalone\";\nexport default nextConfig;"));' \
    && mkdir -p public \
    && npm run build

FROM node:24.21.0-trixie-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
